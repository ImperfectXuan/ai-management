#!/bin/sh
# aiws - AI Workspace CLI
# Unified command-line interface for managing rules, MCP, skills, and secrets
#
# Usage: aiws <command> [options]
#
# Commands:
#   setup       Initialize workspace and vault
#   sync        Sync all configurations to AI tools
#   validate    Validate workspace structure and configs
#   import      Import existing MCP/Skills from tools into workspace
#   mcp         Manage MCP server configurations
#   skills      Manage skills and link them to tools
#   secrets     Manage encrypted secrets

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/lib/common.sh"

# ============================================================================
# Help
# ============================================================================

show_help() {
  printf '%b\n' "\
${BOLD}AI Workspace CLI v${AIWS_VERSION}${NC}

${BOLD}USAGE:${NC}
    aiws <command> [options]

${BOLD}COMMANDS:${NC}
    ${GREEN}setup${NC}       Initialize workspace structure and secrets vault
    ${GREEN}sync${NC}        Sync rules, MCP, and skills (--only rules|mcp|skills to limit)
    ${GREEN}validate${NC}    Validate workspace structure and configurations
    ${GREEN}import${NC}      Import existing MCP/skills from tools into workspace

    ${GREEN}mcp${NC}         Manage MCP server configurations
        list               List configured MCP servers
        add <name>         Add a new MCP server
        remove <name>      Remove an MCP server
        show <name>        Show MCP server details

    ${GREEN}skills${NC}      Manage skills
        list               List all skills and sync status
        link [scope]       Link skills to tools (scope: global|project)
        unlink [scope]     Unlink skills from tools
        install <source>   Install skill from GitHub/npm/path

    ${GREEN}secrets${NC}     Manage encrypted secrets (requires vault setup)
        set <key>          Set a secret value
        list               List secret keys (no values shown)
        remove <key>       Remove a secret
        audit              Show which tools use which secrets

    ${GREEN}memory${NC}     Manage project memory (ADR / context / decisions)
        list [--type <t>]  List memory entries
        new --type <t> --title "..."  Create from template
        show <path>        Show a memory file

    ${GREEN}rules${NC}       Rule versioning and change tracking
        status             Show rules changed since last sync
        history <id>       Show git history for a rule

    ${GREEN}import${NC}      Import existing configs from tools into workspace
        mcp [--from <t>]   Import MCP servers from tools into mcp.json
        skills [--from <t>] Import skills from tools into workspace
        rules [--from <t>]  Import unmanaged rules into rules/domains/
        Options: --scope, --from, --as, --dry-run, -y

    ${GREEN}hooks${NC}       Manage the pre-commit drift guard
        install            Install the git pre-commit hook (idempotent)
        uninstall          Remove the aiws-managed hook

    ${GREEN}ci${NC}          Manage the GitHub Actions auto-sync workflow
        install            Install .github/workflows/aiws-sync.yml (idempotent)
        uninstall          Remove the aiws-managed workflow

    ${GREEN}intake${NC}      Multi-source asset intake (scan/compare/plan/apply/rollback/deploy)
        scan               Read-only multi-source scan (preview)
        compare            Compare scan batch against repo
        plan               Generate review plan from decisions
        apply              Apply review plan to repo
        rollback           Revert a batch's own changes (skips later edits)
        deploy             Copy assets to target projects
        check              Three-way update check
        status             Show batch/plan status

${BOLD}OPTIONS:${NC}
    --tool <name>    Target specific tool (codex|claude|cursor|trae)
    --scope <scope>  Target specific scope (global|project)
    --debug          Enable debug output
    --help, -h       Show this help message

${BOLD}EXAMPLES:${NC}
    aiws setup                    # Initialize workspace
    aiws sync                     # Sync everything
    aiws sync --tool codex        # Sync only for Codex
    aiws sync --only rules        # Sync rules only (what CI auto-sync runs)
    aiws rules status             # Rules changed since last sync
    aiws rules history vue3       # Git history of one rule
    aiws ci install               # Install push-triggered auto-sync workflow
    aiws mcp add github npx       # Add GitHub MCP server
    aiws skills link global       # Link skills globally
    aiws import skills --dry-run  # Preview skill import
    aiws import mcp --from codex  # Import MCP from Codex
    aiws secrets set GITHUB_TOKEN # Set encrypted secret
    aiws memory new --type adr --title "Use age encryption"   # 新建 ADR

${BOLD}ENVIRONMENT:${NC}
    AIWS_ROOT      Workspace root directory (default: git root)
    AIWS_DEBUG     Enable debug output (set to 1)
"
}

# ============================================================================
# Setup Command
# ============================================================================

cmd_setup() {
  local reset_2fa=0
  
  while [ $# -gt 0 ]; do
    case "$1" in
      --reset-2fa) reset_2fa=1; shift ;;
      *) shift ;;
    esac
  done
  
  log_info "Setting up AI Workspace..."
  echo ""
  
  # Create directory structure
  ensure_workspace_structure
  log_success "Directory structure created"
  
  # Create default config if not exists
  if [ ! -f "${AIWS_DIR}/config/workspace.json" ]; then
    cat > "${AIWS_DIR}/config/workspace.json" << 'EOF'
{
  "version": "1.0",
  "tools": ["codex", "claude", "cursor", "trae"],
  "default_scope": "project"
}
EOF
    log_success "Created default config"
  fi
  
  # Create default MCP config if not exists
  if [ ! -f "${AIWS_DIR}/mcp/mcp.json" ]; then
    cat > "${AIWS_DIR}/mcp/mcp.json" << 'EOF'
{
  "servers": {}
}
EOF
    log_success "Created default MCP config"
  fi
  
  # Create default permissions if not exists
  if [ ! -f "${AIWS_DIR}/secrets/permissions.yaml" ]; then
    . "${SCRIPT_DIR}/lib/vault.sh"
    create_default_permissions
  fi
  
  echo ""
  log_info "Workspace setup complete!"

  # Auto-install pre-commit drift guard (skipped silently outside a git repo)
  if git -C "$AIWS_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    . "${SCRIPT_DIR}/lib/hooks.sh"
    install_pre_commit_hook || true
  fi

  echo ""
  log_info "Next steps:"
  printf "  1. Add rules to ${CYAN}%s/rules/00-core.md${NC}\n" "$AIWS_DIR"
  printf "  2. Configure MCP in ${CYAN}%s/mcp/mcp.json${NC}\n" "$AIWS_DIR"
  printf "  3. Add skills to ${CYAN}%s/skills/<name>/SKILL.md${NC}\n" "$AIWS_DIR"
  printf "  4. Run ${CYAN}aiws sync${NC} to sync to all tools\n"
  echo ""
  
  # Optional: Initialize vault
  printf "Initialize secrets vault? [y/N] "
  read -r init_vault
  
  case "$init_vault" in
    [yY]|[yY][eE][sS])
      . "${SCRIPT_DIR}/lib/vault.sh"
      vault_init
      ;;
    *)
      log_info "You can initialize the vault later with: aiws setup"
      ;;
  esac
}

# ============================================================================
# Sync Command
# ============================================================================

cmd_sync() {
  local target_tool=""
  local target_scope=""
  local describe_inputs=0
  local report_file=""
  SYNC_ONLY=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --tool)  target_tool="$2"; shift 2 ;;
      --scope) target_scope="$2"; shift 2 ;;
      --only)  SYNC_ONLY="$2"; shift 2 ;;
      --describe-inputs) describe_inputs=1; shift ;;
      --report-file) report_file="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  # fail-fast：非法 --only 直接拒绝，静默忽略会让人误以为模块已被同步
  case "$SYNC_ONLY" in
    ""|rules|mcp|skills) ;;
    *)
      log_error "Invalid --only value: ${SYNC_ONLY} (expected: rules|mcp|skills)"
      exit 1
      ;;
  esac

  # 只读输入枚举（功能 002）：与执行模式互斥的独立早退路径，stdout 保持纯 JSON。
  if [ "$describe_inputs" = "1" ]; then
    if [ -n "$report_file" ]; then
      log_error "--describe-inputs 与 --report-file 互斥，不能同次调用"
      exit 1
    fi
    if [ -z "$target_tool" ] || [ -z "$target_scope" ] || [ -z "$SYNC_ONLY" ]; then
      log_error "--describe-inputs 需要同时指定 --tool、--scope 与 --only"
      exit 1
    fi
    AIWS_DESCRIBE=1
    export AIWS_DESCRIBE
    . "${SCRIPT_DIR}/lib/sync-describe.sh"
    case "$SYNC_ONLY" in
      rules)  . "${SCRIPT_DIR}/lib/rules-generate.sh" ;;
      mcp)    . "${SCRIPT_DIR}/lib/mcp-sync.sh" ;;
      skills) . "${SCRIPT_DIR}/lib/platform.sh"; . "${SCRIPT_DIR}/lib/skills-link.sh" ;;
    esac
    describe_inputs_main "$target_tool" "$SYNC_ONLY" "$target_scope"
    exit 0
  fi

  # 单元回执（功能 002）：报告模式固定为单一单元，必须给全身份参数。
  # sync-report.sh 已由 common.sh 统一供给；此处仅做初始化校验。
  if [ -n "$report_file" ]; then
    if [ -z "$target_tool" ] || [ -z "$target_scope" ] || [ -z "$SYNC_ONLY" ]; then
      log_error "--report-file 需要同时指定 --tool、--scope 与 --only"
      exit 1
    fi
    sync_report_init "$report_file" "$target_tool" "$SYNC_ONLY" "$target_scope"
  fi

  log_info "AI Workspace sync v${AIWS_VERSION}"
  echo ""

  # Sync rules
  if sync_should_run rules; then
    log_info "Syncing rules..."
    sync_rules "$target_tool" "$target_scope"
  fi

  # Sync MCP（报告模式下即使 mcp.json 缺失也进入，由 sync_mcp 落 no_entries 回执）
  if sync_should_run mcp && { sync_report_active || [ -f "${AIWS_DIR}/mcp/mcp.json" ]; }; then
    echo ""
    # Load vault.sh for secret replacement and permission checks
    if [ -f "${SCRIPT_DIR}/lib/vault.sh" ]; then
      . "${SCRIPT_DIR}/lib/vault.sh"
    fi
    . "${SCRIPT_DIR}/lib/mcp-sync.sh"
    sync_mcp "$target_scope" "$target_tool"
  fi

  # Sync skills（workspace.json skills.enabled=false 时显式跳过并输出原因）
  if sync_should_run skills && { sync_report_active || [ -d "${AIWS_DIR}/skills" ]; }; then
    if is_module_enabled "skills"; then
      echo ""
      . "${SCRIPT_DIR}/lib/platform.sh"
      . "${SCRIPT_DIR}/lib/skills-link.sh"
      sync_skills "$target_scope" "$target_tool"
    else
      echo ""
      log_info "Skills module disabled (config/workspace.json skills.enabled=false). Skipping skills sync."
      sync_report_skip "module_disabled"
    fi
  fi

  echo ""
  log_success "Sync complete!"
}

# --only 过滤谓词：SYNC_ONLY 为空时放行全部模块。
# CI 自动同步只跑 rules（mcp 需要 vault 解 ${secret:} 占位符、skills 会在
# 真实目录产生链接副作用），全量 sync 仍保持原有三模块行为。
sync_should_run() {
  [ -z "${SYNC_ONLY:-}" ] || [ "$SYNC_ONLY" = "$1" ]
}

# Sync rules to tool-native files
sync_rules() {
  local target_tool="$1"
  local target_scope="$2"

  # design §2.1：Rules 仅 project。报告模式显式回 tool_unsupported；
  # 无报告的历史行为保持不变（生成器本就忽略 scope，只写项目文件）。
  if sync_report_active && [ "$target_scope" = "global" ]; then
    sync_report_skip "tool_unsupported"
    return 0
  fi

  local tools
  if [ -n "$target_tool" ]; then
    tools="$target_tool"
  else
    tools="$(get_enabled_tools)"
  fi

  local synced=0
  for tool in $tools; do
    generate_tool_file "$tool" "$target_scope"
    synced=$((synced + 1))
  done

  # 只要有工具成功消费了规则层就落版本化检查点。set -e 下生成失败会中断在
  # 循环内，不会走到这里 —— 避免把"规则已变"误记为"已同步"导致 rules
  # status 永久假干净。版本化自身故障不拖垮 sync 主职。
  if [ "$synced" -gt 0 ] && is_module_enabled "rules.versioning"; then
    . "${SCRIPT_DIR}/lib/rules-versioning.sh"
    rules_versioning_record || log_warn "规则版本化记录失败（不影响同步结果）"
  fi
}

# Generate native file for a tool
generate_tool_file() {
  local tool="$1"
  local target_scope="$2"

  # memory context 注入依赖 memory.sh 的 memory_context_body/memory_has_context
  . "${SCRIPT_DIR}/lib/memory.sh"

  # Cursor/Trae load per-rule files with glob-based on-demand semantics
  case "$tool" in
    cursor|trae)
      . "${SCRIPT_DIR}/lib/rules-generate.sh"
      generate_rule_files "$tool" "$target_scope"
      return 0
      ;;
  esac

  local rules_content=""
  local rule_count=0

  # Collect rules
  for rule_file in "${AIWS_DIR}"/rules/*.md; do
    [ -f "$rule_file" ] || continue
    is_rule_file "$rule_file" || continue
    rule_applies_to_tool "$rule_file" "$tool" || continue
    rules_content="${rules_content}
$(cat "$rule_file")
"
    rule_count=$((rule_count + 1))
  done

  # Domain rules
  if [ -d "${AIWS_DIR}/rules/domains" ]; then
    for rule_file in "${AIWS_DIR}"/rules/domains/*.md; do
      [ -f "$rule_file" ] || continue
      rule_applies_to_tool "$rule_file" "$tool" || continue
      rules_content="${rules_content}
$(cat "$rule_file")
"
      rule_count=$((rule_count + 1))
    done
  fi

  local output_file=""
  local header="<!-- Generated by AI Workspace - DO NOT EDIT MANUALLY -->"

  case "$tool" in
    codex)
      output_file="${AIWS_ROOT}/AGENTS.md"
      ;;
    claude)
      output_file="${AIWS_ROOT}/CLAUDE.md"
      ;;
    *)
      log_warn "Unknown tool: $tool"
      return
      ;;
  esac

  local context_body
  context_body="$(memory_context_body)"

  {
    echo "$header"
    echo ""
    if [ -n "$context_body" ]; then
      echo "<!-- ===== 项目上下文（来自 .ai-workspace/memory/context/，由 aiws sync 注入）===== -->"
      echo ""
      echo "$context_body"
      echo "<!-- ===== /项目上下文 ===== -->"
      echo ""
    fi
    echo "$rules_content"
  } > "$output_file"

  log_success "Generated: $output_file ($tool)"

  # 回执：有规则或有上下文注入才算实际完成；空库写头部文件不冒充已分发（design §4）。
  if [ "$rule_count" -gt 0 ] || [ -n "$context_body" ]; then
    sync_report_apply
  else
    sync_report_skip "no_entries"
  fi
}

# ============================================================================
# Hooks Command
# ============================================================================

cmd_hooks() {
  local action="${1:-install}"

  . "${SCRIPT_DIR}/lib/hooks.sh"

  case "$action" in
    install)
      install_pre_commit_hook
      ;;
    uninstall)
      uninstall_pre_commit_hook
      ;;
    --help|-h|help)
      echo "Usage: aiws hooks <install|uninstall>"
      echo ""
      echo "Manage the git pre-commit hook that blocks commits while"
      echo "generated files have drifted from canonical rules."
      echo ""
      echo "Commands:"
      echo "  install     Install the pre-commit hook (idempotent)"
      echo "  uninstall   Remove the aiws-managed pre-commit hook"
      ;;
    *)
      log_error "Unknown hooks action: $action"
      exit 1
      ;;
  esac
}

# ============================================================================
# CI Commands
# ============================================================================

cmd_ci() {
  . "${SCRIPT_DIR}/lib/ci.sh"

  local action="${1:-install}"

  case "$action" in
    install)
      install_ci_workflow
      ;;
    uninstall)
      uninstall_ci_workflow
      ;;
    --help|-h|help)
      echo "Usage: aiws ci <install|uninstall>"
      echo ""
      echo "Manage the GitHub Actions workflow that syncs generated files on push."
      echo ""
      echo "Commands:"
      echo "  install     Install .github/workflows/aiws-sync.yml (managed files are regenerated)"
      echo "  uninstall   Remove the aiws-managed workflow"
      ;;
    *)
      log_error "Unknown ci action: $action"
      exit 1
      ;;
  esac
}

# ============================================================================
# Validate Command
# ============================================================================

cmd_validate() {
  exec "${SCRIPT_DIR}/validate.sh" "$@"
}

# ============================================================================
# MCP Commands
# ============================================================================

cmd_mcp() {
  . "${SCRIPT_DIR}/lib/mcp-sync.sh"
  
  local subcmd="${1:-list}"
  shift || true
  
  case "$subcmd" in
    list)
      mcp_list
      ;;
    add)
      local name="$1"
      shift || true
      if [ -z "$name" ]; then
        log_error "Usage: aiws mcp add <name> <command> [args...]"
        exit 1
      fi
      mcp_add "$name" "$@"
      ;;
    remove)
      mcp_remove "$1"
      ;;
    show)
      mcp_show "$1"
      ;;
    *)
      log_error "Unknown mcp subcommand: $subcmd"
      log_info "Available: list, add, remove, show"
      exit 1
      ;;
  esac
}

# ============================================================================
# Skills Commands
# ============================================================================

cmd_skills() {
  . "${SCRIPT_DIR}/lib/platform.sh"
  . "${SCRIPT_DIR}/lib/skills-link.sh"
  
  local subcmd="${1:-list}"
  shift || true
  
  case "$subcmd" in
    list)
      skills_list
      ;;
    link)
      local scope="${1:-global}"
      local tool=""
      local skill_name=""
      if [ -n "${3:-}" ]; then
        tool="${2:-}"
        skill_name="${3:-}"
      elif is_supported_tool "${2:-}"; then
        tool="${2:-}"
      else
        skill_name="${2:-}"
      fi
      skills_link "$scope" "$tool" "$skill_name"
      ;;
    unlink)
      local scope="${1:-global}"
      local tool=""
      local skill_name=""
      if [ -n "${3:-}" ]; then
        tool="${2:-}"
        skill_name="${3:-}"
      elif is_supported_tool "${2:-}"; then
        tool="${2:-}"
      else
        skill_name="${2:-}"
      fi
      skills_unlink "$scope" "$tool" "$skill_name"
      ;;
    install)
      skills_install "$1"
      ;;
    *)
      log_error "Unknown skills subcommand: $subcmd"
      log_info "Available: list, link, unlink, install"
      exit 1
      ;;
  esac
}

# ============================================================================
# Rules Commands
# ============================================================================

cmd_rules() {
  . "${SCRIPT_DIR}/lib/rules-versioning.sh"

  local subcmd="${1:-status}"
  shift || true

  case "$subcmd" in
    status)
      rules_status
      ;;
    history)
      rules_history "${1:-}"
      ;;
    --help|-h|help)
      echo "Usage: aiws rules <status|history <id>>"
      echo ""
      echo "Rule versioning and change tracking."
      echo ""
      echo "Commands:"
      echo "  status         Show rules changed since the last sync (vs manifest)"
      echo "  history <id>   Show git history for a rule (id or rules/ relative path)"
      echo ""
      echo "Exit codes for status: 0 clean, 1 changed, 2 environment error"
      ;;
    *)
      log_error "Unknown rules subcommand: $subcmd"
      log_info "Available: status, history"
      exit 1
      ;;
  esac
}

# ============================================================================
# Memory Commands
# ============================================================================

cmd_memory() {
  . "${SCRIPT_DIR}/lib/memory.sh"

  local subcmd="${1:-list}"
  shift || true

  local type=""
  local title=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --type)  type="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      *) break ;;
    esac
  done

  case "$subcmd" in
    list)
      memory_list "$type"
      ;;
    new)
      if [ -z "$type" ] || [ -z "$title" ]; then
        log_error "Usage: aiws memory new --type adr|context|decisions --title \"...\""
        exit 1
      fi
      memory_new "$type" "$title"
      ;;
    show)
      memory_show "$1"
      ;;
    --help|-h|help)
      echo "Usage: aiws memory <list|new|show>"
      echo ""
      echo "管理项目记忆（ADR / context / decisions）。"
      echo ""
      echo "Commands:"
      echo "  list [--type adr|context|decisions]   列出记忆条目"
      echo "  new --type <t> --title \"...\"          从模板新建（adr 编号自增、decisions 追加）"
      echo "  show <path>                          打印记忆文件（相对 memory/，如 adr/0001.md）"
      ;;
    *)
      log_error "Unknown memory subcommand: $subcmd"
      log_info "Available: list, new, show"
      exit 1
      ;;
  esac
}

# ============================================================================
# Secrets Commands
# ============================================================================

cmd_secrets() {
  . "${SCRIPT_DIR}/lib/vault.sh"
  
  local subcmd="${1:-list}"
  shift || true
  
  # audit and json mode don't need vault deps - they only read file state / permissions.yaml
  if [ "$subcmd" != "audit" ] && [ "${AIWS_JSON:-0}" != "1" ]; then
    if ! check_vault_deps 2>/dev/null; then
      log_error "Vault dependencies not met"
      log_info "Install with: brew install age oath-toolkit"
      exit 1
    fi
  fi
  
  case "$subcmd" in
    set)
      vault_set "$1" "$2"
      ;;
    list)
      vault_list
      ;;
    remove)
      vault_remove "$1"
      ;;
    audit)
      vault_audit
      ;;
    *)
      log_error "Unknown secrets subcommand: $subcmd"
      log_info "Available: set, list, remove, audit"
      exit 1
      ;;
  esac
}

# ============================================================================
# Import Command
# ============================================================================

cmd_import() {
  local what="${1:-}"

  # Handle help flag regardless of position
  case "$what" in
    --help|-h|help)
      echo ""
      log_info "Usage: aiws import <mcp|skills|rules> [options]"
      echo ""
      log_info "Import existing tool configurations into workspace:"
      printf "  ${GREEN}mcp${NC}     Import MCP servers from tools into mcp.json\n"
      printf "  ${GREEN}skills${NC}  Import skills from tools into .ai-workspace/skills/\n"
      printf "  ${GREEN}rules${NC}   Import unmanaged rules from tools into .ai-workspace/rules/domains/\n"
      echo ""
      log_info "Options:"
      printf "  ${CYAN}--from <tool>${NC}   Import from specific tool (codex|claude|cursor|trae)\n"
      printf "  ${CYAN}--scope <scope>${NC} Target scope (global|project)\n"
      printf "  ${CYAN}--as <name>${NC}     Rule name for merged-file import (requires --from claude|codex)\n"
      printf "  ${CYAN}--dry-run${NC}      Preview without making changes\n"
      printf "  ${CYAN}--yes, -y${NC}      Skip confirmation prompt\n"
      echo ""
      log_info "Examples:"
      printf "  aiws import skills --dry-run          # Preview skill discovery\n"
      printf "  aiws import skills --from claude      # Import skills from Claude\n"
      printf "  aiws import mcp --from codex --scope global  # Import Codex MCP\n"
      printf "  aiws import rules --from cursor       # Import hand-written Cursor rules\n"
      printf "  aiws import rules --from claude --as my-rules # Import CLAUDE.md as one rule\n"
      echo ""
      return 0
      ;;
  esac

  shift || true
  local from_tool=""
  local scope_filter=""
  local dry_run=0
  local auto_yes=0
  local as_name=""

  # Parse options
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)  from_tool="$2"; shift 2 ;;
      --scope) scope_filter="$2"; shift 2 ;;
      --as)    as_name="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      --yes|-y) auto_yes=1; shift ;;
      --help|-h)
        echo ""
        log_info "Usage: aiws import <mcp|skills|rules> [options]"
        echo ""
        log_info "Options:"
        printf "  ${CYAN}--from <tool>${NC}   Import from specific tool (codex|claude|cursor|trae)\n"
        printf "  ${CYAN}--scope <scope>${NC} Target scope (global|project)\n"
        printf "  ${CYAN}--dry-run${NC}      Preview without making changes\n"
        printf "  ${CYAN}--yes, -y${NC}      Skip confirmation prompt\n"
        echo ""
        log_info "Examples:"
        printf "  aiws import skills --dry-run          # Preview skill discovery\n"
        printf "  aiws import skills --from claude      # Import skills from Claude\n"
        printf "  aiws import mcp --from codex --scope global  # Import Codex MCP\n"
        echo ""
        return 0
        ;;
      *)
        log_error "Unknown option: $1"
        return 1
        ;;
    esac
  done

  case "$what" in
    mcp)
      . "${SCRIPT_DIR}/lib/import-mcp.sh"
      import_mcp "$from_tool" "$scope_filter" "$dry_run" "$auto_yes"
      ;;
    skills)
      . "${SCRIPT_DIR}/lib/import-skills.sh"
      import_skills "$from_tool" "$scope_filter" "$dry_run" "$auto_yes"
      ;;
    rules)
      . "${SCRIPT_DIR}/lib/import-rules.sh"
      import_rules "$from_tool" "$scope_filter" "$dry_run" "$auto_yes" "$as_name"
      ;;
    help|"")
      log_info "Usage: aiws import <mcp|skills|rules> [--from <tool>] [--scope <scope>] [--as <name>] [--dry-run] [-y]"
      echo ""
      log_info "Subcommands:"
      printf "  ${GREEN}mcp${NC}     Import MCP servers from tools into mcp.json\n"
      printf "  ${GREEN}skills${NC}  Import skills from tools into .ai-workspace/skills/\n"
      printf "  ${GREEN}rules${NC}   Import unmanaged rules from tools into .ai-workspace/rules/domains/\n"
      ;;
    *)
      log_error "Unknown import target: $what"
      log_info "Usage: aiws import <mcp|skills|rules> [--from <tool>] [--scope <scope>] [--as <name>] [--dry-run] [-y]"
      exit 1
      ;;
  esac
}

# ============================================================================
# Intake Command (multi-source asset intake)
# ============================================================================

cmd_intake() {
  local subcmd="${1:-help}"
  shift || true

  case "$subcmd" in
    scan)
      cmd_intake_scan "$@"
      ;;
    compare)
      cmd_intake_compare "$@"
      ;;
    plan)
      cmd_intake_plan "$@"
      ;;
    apply)
      cmd_intake_apply "$@"
      ;;
    rollback)
      cmd_intake_rollback "$@"
      ;;
    status)
      cmd_intake_status "$@"
      ;;
    model)
      cmd_intake_model "$@"
      ;;
    help|--help|-h|"")
      echo ""
      log_info "Usage: aiws intake <scan|compare|plan|apply|rollback|deploy|check|status> [options]"
      echo ""
      log_info "Scan (read-only multi-source scan):"
      printf "  ${CYAN}--repo <path>${NC}        Repo (总库) path (required)\n"
      printf "  ${CYAN}--source <spec>${NC}      Source: <path>[:tool[:scope]] (repeatable)\n"
      printf "  ${CYAN}                        tool: codex|claude|cursor|trae|auto (default auto)\n"
      printf "  ${CYAN}                        scope: project|global (default project)\n"
      printf "  ${CYAN}--manual-file <path>${NC}  Manual rule file (repeatable)\n"
      printf "  ${CYAN}--manual-skill <path>${NC} Manual skill directory (repeatable)\n"
      printf "  ${CYAN}--preview${NC}             Pure preview: output JSON, do not persist batch record\n"
      printf "  ${CYAN}--out-dir <path>${NC}     Batch output directory (default: <repo>/.ai-workspace/intake/batches/)\n"
      printf "  ${CYAN}--cancel-file <path>${NC} Cancel file path (touch to cancel)\n"
      printf "  ${CYAN}--json${NC}                JSON output to stdout\n"
      echo ""
      log_info "Examples:"
      printf "  aiws intake scan --repo ~/my-repo --source ~/project-a --source ~/.cursor:cursor:global\n"
      printf "  aiws intake scan --repo ~/my-repo --source ~/project-a:cursor:project --manual-file ~/notes/rule.md\n"
      echo ""
      log_info "Compare (确定性比较，只写本地候选记录):"
      printf "  ${CYAN}--repo <path>${NC}        Repo (总库) path (required)\n"
      printf "  ${CYAN}--batch <id>${NC}         Scan batch id (required)\n"
      printf "  ${CYAN}--json${NC}                JSON output to stdout\n"
      echo ""
      log_info "Examples:"
      printf "  aiws intake compare --repo ~/my-repo --batch batch-20261010-120000-ab12cd\n"
      echo ""
      log_info "Plan / Apply (人工审核计划与增量入库):"
      printf "  ${CYAN}--repo <path>${NC}        Repo (总库) path (required)\n"
      printf "  ${CYAN}--batch <id>${NC}         Scan batch id\n"
      printf "  ${CYAN}--decisions <file>${NC}   Human decisions file (plan)\n"
      printf "  ${CYAN}--plan <file|id>${NC}     Review plan file or plan id (apply)\n"
      printf "  ${CYAN}--resume${NC}             Continue an interrupted apply (status=failed/incomplete)\n"
      printf "  ${CYAN}--cancel-file <path>${NC} Cancel file path (apply)\n"
      printf "  ${CYAN}--apply <id>${NC}         Apply id (rollback)\n"
      printf "  ${CYAN}--json${NC}                JSON output to stdout\n"
      echo ""
      log_info "Examples:"
      printf "  aiws intake plan --repo ~/my-repo --batch <id> --decisions decisions.json\n"
      printf "  aiws intake apply --repo ~/my-repo --plan ~/my-repo/.ai-workspace/intake/plans/<plan-id>.json\n"
      printf "  aiws intake status --repo ~/my-repo              # 总库全部执行历史与计划\n"
      printf "  aiws intake status --repo ~/my-repo --plan <plan-id>\n"
      printf "  aiws intake rollback --repo ~/my-repo --apply <apply-id>\n"
      echo ""
      log_info "Model (AI 辅助整理边界；无配置时整条人工闭环不受影响):"
      printf "  ${CYAN}--base-url <url>${NC}     OpenAI-compatible base URL (含版本段，如 http://localhost:11434/v1)\n"
      printf "  ${CYAN}--model <name>${NC}       Model name\n"
      printf "  ${CYAN}--credential-ref <key>${NC} Vault key name (null 表示本地服务无需凭据)\n"
      printf "  ${CYAN}--no-credential${NC}      Clear credential reference (local services)\n"
      printf "  ${CYAN}--candidate <id>${NC}     Candidate id (repeatable, prepare)\n"
      printf "  ${CYAN}--request <id>${NC}       Request id (send/show)\n"
      printf "  ${CYAN}--batch <n>${NC}          Batch index (send；缺省发送全部已确认批次)\n"
      printf "  ${CYAN}--with-repo${NC}          Include repo asset digests for similarity\n"
      printf "  ${CYAN}--json${NC}               JSON output to stdout\n"
      echo ""
      log_info "Examples:"
      printf "  aiws intake model config --repo ~/my-repo --base-url http://localhost:11434/v1 --model qwen2.5:14b\n"
      printf "  aiws intake model prepare --repo ~/my-repo --batch <id> --candidate <cid> --with-repo\n"
      printf "  aiws intake model send --repo ~/my-repo --request <ai-id> --batch 1\n"
      ;;

    deploy|check)
      log_warn "aiws intake ${subcmd} 尚未实现（属后续 TASK）"
      exit 1
      ;;
    *)
      log_error "Unknown intake subcommand: $subcmd"
      log_info "Usage: aiws intake <scan|compare|plan|apply|rollback|deploy|check|status>"
      exit 1
      ;;
  esac
}

cmd_intake_scan() {
  . "${SCRIPT_DIR}/lib/intake/identity.sh"
  . "${SCRIPT_DIR}/lib/intake/scan.sh"
  . "${SCRIPT_DIR}/lib/intake/store.sh"
  . "${SCRIPT_DIR}/lib/import-mcp.sh"

  local repo="" json_output=0 out_dir="" cancel_file="" preview_mode=0
  local manual_files="" manual_skills=""
  INTAKE_SOURCES=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        repo="$2"; shift 2 ;;
      --source)
        # 格式: path[:tool[:scope]]
        local spec="$2" spath stool sscope
        spath="${spec%%:*}"
        local rest="${spec#*:}"
        if [ "$rest" = "$spec" ]; then
          stool="auto"; sscope="project"
        else
          stool="${rest%%:*}"
          sscope="${rest#*:}"
          [ "$sscope" = "$rest" ] && sscope="project"
          [ -z "$stool" ] && stool="auto"
          [ -z "$sscope" ] && sscope="project"
        fi
        INTAKE_SOURCES="${INTAKE_SOURCES}${spath}|${stool}|${sscope}
"
        shift 2 ;;
      --manual-file)
        manual_files="${manual_files}${2}
"; shift 2 ;;
      --manual-skill)
        manual_skills="${manual_skills}${2}
"; shift 2 ;;
      --preview)
        preview_mode=1; json_output=1; shift ;;
      --out-dir)
        out_dir="$2"; shift 2 ;;
      --cancel-file)
        cancel_file="$2"; shift 2 ;;
      --json)
        json_output=1; shift ;;
      --help|-h)
        cmd_intake help; return 0 ;;
      *)
        log_error "Unknown option for intake scan: $1"
        return 1 ;;
    esac
  done

  if [ -z "$repo" ]; then
    die "intake scan: 必须指定 --repo（总库路径）"
  fi

  if [ ! -d "$repo" ]; then
    die "intake scan: repo 目录不存在: $repo"
  fi

  if [ -z "$INTAKE_SOURCES" ] && [ -z "$manual_files" ] && [ -z "$manual_skills" ]; then
    die "intake scan: 至少指定一个来源（--source / --manual-file / --manual-skill）"
  fi

  # 需要 jq
  if ! has_jq; then
    die "jq is required for intake scan"
  fi

  export INTAKE_REPO="$repo"
  export INTAKE_SOURCES
  export INTAKE_MANUAL_FILES="$manual_files"
  export INTAKE_MANUAL_SKILLS="$manual_skills"
  export INTAKE_CANCEL_FILE="$cancel_file"

  local batch_id
  batch_id="$(intake_new_batch_id)"
  export INTAKE_BATCH_ID="$batch_id"

  if [ -n "$out_dir" ]; then
    export INTAKE_OUT_DIR="$out_dir"
    mkdir -p "$out_dir"
  fi

  # 运行扫描
  local result
  result="$(intake_scan)"

  # 写入批次记录（--preview 时不持久化）
  if [ "$preview_mode" = "1" ]; then
    : # 纯预览：不写入批次记录
  elif [ -n "${INTAKE_OUT_DIR:-}" ]; then
    printf '%s\n' "$result" > "${INTAKE_OUT_DIR}/scan.json"
  else
    intake_batch_write_scan "$repo" "$batch_id" "$result"
  fi

  if [ "$json_output" = "1" ]; then
    printf '%s\n' "$result"
  else
    # 人类可读摘要
    local occ_count src_count err_count
    occ_count="$(printf '%s' "$result" | jq '.occurrences | length')"
    src_count="$(printf '%s' "$result" | jq '.sources | length')"
    err_count="$(printf '%s' "$result" | jq '.errors | length')"
    log_success "扫描完成 batch=${batch_id}"
    log_info "  来源: ${src_count}  资产候选: ${occ_count}  错误: ${err_count}"
    if [ "$preview_mode" = "1" ]; then
      log_info "  模式: 纯预览（未保存批次记录）"
    else
      log_info "  结果: $(intake_batch_dir "$repo" "$batch_id")/scan.json"
    fi
    if [ "$err_count" -gt 0 ]; then
      log_warn "  错误详情:"
      printf '%s' "$result" | jq -r '.errors[] | "    [\(.level)] \(.source // "?"): \(.message)"'
    fi
  fi
}

cmd_intake_compare() {
  . "${SCRIPT_DIR}/lib/intake/identity.sh"
  . "${SCRIPT_DIR}/lib/intake/scan.sh"
  . "${SCRIPT_DIR}/lib/intake/store.sh"
  . "${SCRIPT_DIR}/lib/intake/compare.sh"
  . "${SCRIPT_DIR}/lib/import-mcp.sh"

  local repo="" batch="" json_output=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        repo="$2"; shift 2 ;;
      --batch)
        batch="$2"; shift 2 ;;
      --json)
        json_output=1; shift ;;
      --help|-h)
        cmd_intake help; return 0 ;;
      *)
        log_error "Unknown option for intake compare: $1"
        return 1 ;;
    esac
  done

  if [ -z "$repo" ]; then
    die "intake compare: 必须指定 --repo（总库路径）"
  fi

  if [ -z "$batch" ]; then
    die "intake compare: 必须指定 --batch（扫描批次 ID）"
  fi

  if [ ! -d "$repo" ]; then
    die "intake compare: repo 目录不存在: $repo"
  fi

  if ! has_jq; then
    die "jq is required for intake compare"
  fi

  export INTAKE_REPO="$repo"
  export INTAKE_BATCH_ID="$batch"

  local result
  result="$(intake_compare)"

  # 候选只写本地记录区；总库规范源保持只读
  intake_batch_write_candidates "$repo" "$batch" "$result"

  if [ "$json_output" = "1" ]; then
    printf '%s\n' "$result"
    return 0
  fi

  local total conflict unparsable deferred
  total="$(printf '%s' "$result" | jq '.summary.total')"
  conflict="$(printf '%s' "$result" | jq '.summary.conflict')"
  unparsable="$(printf '%s' "$result" | jq '.summary.unparseable')"
  deferred="$(printf '%s' "$result" | jq '.summary.deferred')"

  log_success "比较完成 batch=${batch}"
  log_info "  候选: ${total}  冲突: ${conflict}  无法解析: ${unparsable}  暂缓: ${deferred}"
  printf '%s' "$result" | jq -r '.candidates[] | "    [\(.labels | join(","))] \(.type) \(.display_name) <- \(.sources | length) 个来源"'
  log_info "  结果: $(intake_batch_dir "$repo" "$batch")/candidates.json"

  if ! intake_check_gitignore "$repo"; then
    log_warn "  .ai-workspace/intake/ 未加入 .gitignore，本地记录可能被误提交"
  fi
}

# intake plan/apply/status/rollback 共用引擎加载
intake_load_engine() {
  . "${SCRIPT_DIR}/lib/intake/paths.sh"
  . "${SCRIPT_DIR}/lib/intake/identity.sh"
  . "${SCRIPT_DIR}/lib/intake/credentials.sh"
  . "${SCRIPT_DIR}/lib/intake/scan.sh"
  . "${SCRIPT_DIR}/lib/intake/store.sh"
  . "${SCRIPT_DIR}/lib/intake/compare.sh"
  . "${SCRIPT_DIR}/lib/intake/plan.sh"
  . "${SCRIPT_DIR}/lib/intake/stage.sh"
  . "${SCRIPT_DIR}/lib/intake/commit.sh"
  . "${SCRIPT_DIR}/lib/intake/recover.sh"
  . "${SCRIPT_DIR}/lib/intake/apply.sh"
  . "${SCRIPT_DIR}/lib/intake/model.sh"
  . "${SCRIPT_DIR}/lib/intake/model-io.sh"
  . "${SCRIPT_DIR}/lib/import-mcp.sh"
  . "${SCRIPT_DIR}/lib/import-rules.sh"
}

cmd_intake_plan() {
  intake_load_engine

  local repo="" batch="" decisions="" json_output=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        repo="$2"; shift 2 ;;
      --batch)
        batch="$2"; shift 2 ;;
      --decisions)
        decisions="$2"; shift 2 ;;
      --json)
        json_output=1; shift ;;
      --help|-h)
        cmd_intake help; return 0 ;;
      *)
        log_error "Unknown option for intake plan: $1"
        return 1 ;;
    esac
  done

  if [ -z "$repo" ]; then
    die "intake plan: 必须指定 --repo（总库路径）"
  fi
  if [ -z "$batch" ]; then
    die "intake plan: 必须指定 --batch（扫描批次 ID）"
  fi
  if [ -z "$decisions" ]; then
    die "intake plan: 必须指定 --decisions（人工决定文件）"
  fi
  if ! has_jq; then
    die "jq is required for intake plan"
  fi

  export INTAKE_REPO="$repo"
  export INTAKE_BATCH_ID="$batch"
  export INTAKE_DECISIONS_FILE="$decisions"

  local result
  result="$(intake_plan_build)"

  if [ "$(printf '%s' "$result" | jq -r '.ok')" != "true" ]; then
    log_error "intake plan: 人工决定无法生成计划"
    printf '%s' "$result" | jq -r '.errors[]' >&2
    return 1
  fi

  local plan plan_id plan_file
  plan="$(printf '%s' "$result" | jq -c '.plan')"
  plan_id="$(printf '%s' "$plan" | jq -r '.plan_id')"
  plan_file="$(intake_plan_path "$repo" "$plan_id")"
  intake_plan_write "$repo" "$plan_id" "$plan"

  if [ "$json_output" = "1" ]; then
    printf '%s\n' "$plan"
    return 0
  fi

  log_success "计划已生成 plan=${plan_id}"
  log_info "  动作: 新增 $(printf '%s' "$plan" | jq -r '.summary.add')  关联 $(printf '%s' "$plan" | jq -r '.summary.link')  更新 $(printf '%s' "$plan" | jq -r '.summary.update')  变体 $(printf '%s' "$plan" | jq -r '.summary.variant')"
  log_info "        忽略 $(printf '%s' "$plan" | jq -r '.summary.ignore')  暂缓 $(printf '%s' "$plan" | jq -r '.summary.defer')  未处理 $(printf '%s' "$plan" | jq -r '.summary.unresolved')"
  printf '%s' "$plan" | jq -r '.actions[] | "    [\(.kind)] \(.asset_type) \(.asset_name)"'
  log_info "  计划: ${plan_file}"

  if [ "$(printf '%s' "$plan" | jq -r '.summary.unresolved')" != "0" ]; then
    log_warn "  仍有未处理的冲突或无法解析候选，apply 会拒绝执行："
    printf '%s' "$plan" | jq -r '.unresolved[] | "    " + .' >&2
  fi
}

cmd_intake_apply() {
  intake_load_engine

  local repo="" plan_arg="" json_output=0 cancel_file="" resume=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        repo="$2"; shift 2 ;;
      --plan)
        plan_arg="$2"; shift 2 ;;
      --cancel-file)
        cancel_file="$2"; shift 2 ;;
      --resume)
        resume=1; shift ;;
      --json)
        json_output=1; shift ;;
      --help|-h)
        cmd_intake help; return 0 ;;
      *)
        log_error "Unknown option for intake apply: $1"
        return 1 ;;
    esac
  done

  if [ -z "$repo" ]; then
    die "intake apply: 必须指定 --repo（总库路径）"
  fi
  if [ -z "$plan_arg" ]; then
    die "intake apply: 必须指定 --plan（计划文件或计划 ID）"
  fi
  if ! has_jq; then
    die "jq is required for intake apply"
  fi

  # --plan 可给文件路径或计划 ID
  local plan_file="$plan_arg"
  if [ ! -f "$plan_file" ]; then
    plan_file="$(intake_plan_path "$repo" "$plan_arg")"
    if [ ! -f "$plan_file" ]; then
      die "intake apply: 找不到计划: $plan_arg"
    fi
  fi

  export INTAKE_REPO="$repo"
  export INTAKE_PLAN_FILE="$plan_file"
  export INTAKE_CANCEL_FILE="$cancel_file"
  export INTAKE_RESUME="$resume"

  local result rc=0
  result="$(intake_apply)" || rc=$?

  if [ "$json_output" = "1" ]; then
    if [ -n "$result" ]; then
      printf '%s\n' "$result"
    fi
    return $rc
  fi

  if [ "$rc" != "0" ]; then
    return $rc
  fi

  log_success "intake apply: 完成 apply=$(printf '%s' "$result" | jq -r '.apply_id')"
  log_info "  状态: $(printf '%s' "$result" | jq -r '.status')  文件变更: $(printf '%s' "$result" | jq -r '.files | length')  新版本: $(printf '%s' "$result" | jq -r '.created_versions | length')"
  log_info "  执行记录: $(intake_history_path "$repo" "$(printf '%s' "$result" | jq -r '.apply_id')")"
  return $rc
}

cmd_intake_rollback() {
  intake_load_engine

  local repo="" apply_id="" json_output=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        repo="$2"; shift 2 ;;
      --apply)
        apply_id="$2"; shift 2 ;;
      --json)
        json_output=1; shift ;;
      --help|-h)
        cmd_intake help; return 0 ;;
      *)
        log_error "Unknown option for intake rollback: $1"
        return 1 ;;
    esac
  done

  if [ -z "$repo" ]; then
    die "intake rollback: 必须指定 --repo（总库路径）"
  fi
  if [ -z "$apply_id" ]; then
    die "intake rollback: 必须指定 --apply（执行 ID）"
  fi

  export INTAKE_REPO="$repo"
  export INTAKE_APPLY_ID="$apply_id"

  local result rc=0
  result="$(intake_apply_rollback)" || rc=$?

  if [ "$json_output" = "1" ]; then
    if [ -n "$result" ]; then
      printf '%s\n' "$result"
    fi
    return $rc
  fi

  if [ "$rc" = "0" ]; then
    log_success "intake rollback: 已回退 $(printf '%s' "$result" | jq -r '.apply_id')（恢复 $(printf '%s' "$result" | jq -r '.rollback.restored | length') 个路径）"
  fi
  return $rc
}

cmd_intake_status() {
  intake_load_engine

  local repo="" plan_id="" batch="" json_output=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        repo="$2"; shift 2 ;;
      --plan)
        plan_id="$2"; shift 2 ;;
      --batch)
        batch="$2"; shift 2 ;;
      --json)
        json_output=1; shift ;;
      --help|-h)
        cmd_intake help; return 0 ;;
      *)
        log_error "Unknown option for intake status: $1"
        return 1 ;;
    esac
  done

  if [ -z "$repo" ]; then
    die "intake status: 必须指定 --repo（总库路径）"
  fi
  # --plan/--batch 只是过滤条件：不带时查询总库全部执行历史与计划
  export INTAKE_REPO="$repo"
  export INTAKE_PLAN_ID="$plan_id"
  export INTAKE_BATCH_ID="$batch"

  local result
  result="$(intake_apply_status)"

  if [ "$json_output" = "1" ]; then
    printf '%s\n' "$result"
    return 0
  fi

  printf '%s' "$result" | jq -r '.apply_history[] | "  \(.status)\t\(.apply_id)\t已应用 \(.applied_actions) 项，失败 \(.failed_actions) 项"'
  printf '%s' "$result" | jq -r '.plans[] | select(.error == null) | "  计划 \(.plan_id)：动作 \(.actions | length) 项，未处理 \(.unresolved | length) 项"'
}

cmd_intake_model() {
  intake_load_engine

  local sub="${1:-help}"
  shift || true
  local repo="" json_output=0
  local base_url="" model="" cred_ref="" timeout_ms="" max_retries="" has_config_flags=0
  local batch="" candidates="" with_repo=0 max_bytes=200000
  local request_id="" batch_index=0 retry="" cancel_file="" plan_id=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --base-url) base_url="$2"; has_config_flags=1; shift 2 ;;
      --model) model="$2"; has_config_flags=1; shift 2 ;;
      --credential-ref) cred_ref="$2"; has_config_flags=1; shift 2 ;;
      --no-credential) cred_ref="__null__"; has_config_flags=1; shift ;;
      --timeout-ms) timeout_ms="$2"; has_config_flags=1; shift 2 ;;
      --max-retries) max_retries="$2"; has_config_flags=1; shift 2 ;;
      --batch)
        if [ "$sub" = "prepare" ]; then batch="$2"; else batch_index="$2"; fi
        shift 2 ;;
      --candidate) candidates="${candidates}${2}
"; shift 2 ;;
      --with-repo) with_repo=1; shift ;;
      --max-bytes) max_bytes="$2"; shift 2 ;;
      --request) request_id="$2"; shift 2 ;;
      --retry) retry="$2"; shift 2 ;;
      --cancel-file) cancel_file="$2"; shift 2 ;;
      --json) json_output=1; shift ;;
      --help|-h) cmd_intake help; return 0 ;;
      *)
        log_error "Unknown option for intake model: $1"
        return 1 ;;
    esac
  done

  if [ -z "$repo" ]; then
    die "intake model: 必须指定 --repo（总库路径）"
  fi
  if ! has_jq; then
    die "jq is required for intake model"
  fi
  export INTAKE_REPO="$repo"

  case "$sub" in
    config)
      if [ "$has_config_flags" = "0" ]; then
        local current check
        current="$(intake_model_config_read "$repo")"
        check="$(intake_model_config_validate "$current")"
        if [ "$json_output" = "1" ]; then
          jq -nc --argjson c "$current" --argjson v "$check"             '{schema: "intake/v1", configured: $v.ok, config: $c,
              readiness: {ok: $v.ok, errors: $v.errors}}'
        else
          if [ "$(printf '%s' "$check" | jq -r '.ok')" = "true" ]; then
            log_success "模型服务已配置"
            printf '%s' "$check" | jq -r '.config | "  地址: \(.base_url)\n  模型: \(.model)\n  凭据引用: \(.credential_ref // "（无，适用于本地服务）")"'
          else
            log_warn "模型服务未配置完整：$(printf '%s' "$check" | jq -r '.errors | join(", ")')"
            log_info "  AI 辅助整理不可用；扫描、审核、入库等人工闭环不受影响"
          fi
        fi
        return 0
      fi

      local next
      next="$(intake_model_config_read "$repo" | jq -c \
        --arg u "$base_url" --arg m "$model" --arg c "$cred_ref" \
        --arg t "$timeout_ms" --arg r "$max_retries" '
        . + (if $u == "" then {} else {base_url: $u} end)
        + (if $m == "" then {} else {model: $m} end)
        + (if $c == "__null__" then {credential_ref: null}
           elif $c == "" then {} else {credential_ref: $c} end)
        + (if $t == "" then {} else {timeout_ms: ($t | tonumber? // 60000)} end)
        + (if $r == "" then {} else {max_retries: ($r | tonumber? // 2)} end)')"
      local check2
      check2="$(intake_model_config_validate "$next")"
      if [ "$(printf '%s' "$check2" | jq -r '.ok')" != "true" ]; then
        log_error "intake model config: 配置非法：$(printf '%s' "$check2" | jq -r '.errors | join(", ")')"
        return 1
      fi
      intake_model_config_write "$repo" "$(printf '%s' "$check2" | jq -c '.config')"
      if [ "$json_output" = "1" ]; then
        printf '%s' "$check2" | jq -c '{schema: "intake/v1", configured: true, config: .config}'
        printf '\n'
      else
        log_success "模型服务配置已写入 $(intake_model_config_path "$repo")（只保存凭据引用名，不保存凭据值）"
      fi
      ;;

    prepare)
      if [ -z "$batch" ]; then
        die "intake model prepare: 必须指定 --batch（扫描批次 ID）"
      fi
      local ids
      ids="$(printf '%s' "$candidates" | jq -R -s 'split("\n") | map(select(length > 0))')"
      if [ "$(printf '%s' "$ids" | jq 'length')" = "0" ]; then
        die "intake model prepare: 至少指定一个 --candidate（只发送用户选定的范围）"
      fi
      local prep
      prep="$(intake_model_prepare "$repo" "$batch" "$ids" \
        "$([ "$with_repo" = "1" ] && echo true || echo false)" "$max_bytes")"
      if [ "$(printf '%s' "$prep" | jq -r '.ok')" != "true" ]; then
        if [ "$json_output" = "1" ]; then
          printf '%s\n' "$(printf '%s' "$prep" | jq -c '.')"
        fi
        log_error "intake model prepare: 无法生成请求：$(printf '%s' "$prep" | jq -r '.errors | join(", ")')"
        printf '%s' "$prep" | jq -r '.details[]? | "  \(.candidate_id // "-"): \(.error)"' >&2
        return 1
      fi
      request_id="$(printf '%s' "$prep" | jq -r '.request.request_id')"
      intake_ai_request_write "$repo" "$request_id" "$(printf '%s' "$prep" | jq -c '.request')"
      if [ "$json_output" = "1" ]; then
        printf '%s' "$prep" | jq -c '.request'
        printf '\n'
      else
        log_success "请求已准备（尚未发送）request=${request_id}"
        printf '%s' "$prep" | jq -r '.request | "  目标: \(.target.endpoint)\n  模型: \(.target.model)\n  批次: \(.batches | length)\n  候选: \(.candidate_ids | length)"'
        printf '%s' "$prep" | jq -r '.request.batches[] | "  batch \(.index)/\(.total)：\(.bytes) 字节，\(.candidate_ids | length) 个候选"'
        log_info "  确认发送请运行: aiws intake model send --repo ${repo} --request ${request_id} --batch <n>"
      fi
      ;;

    send)
      if [ -z "$request_id" ]; then
        die "intake model send: 必须指定 --request（请求 ID）"
      fi
      export INTAKE_REQUEST_ID="$request_id"
      export INTAKE_BATCH_INDEX="$batch_index"
      export INTAKE_CANCEL_FILE="$cancel_file"
      local req_cfg retries
      req_cfg="$(intake_ai_request_read "$repo" "$request_id")"
      retries="${retry:-$(printf '%s' "$req_cfg" | jq -r '.max_retries // 0' 2>/dev/null || echo 0)}"
      export INTAKE_MAX_RETRIES="${retries:-0}"

      local result rc=0
      result="$(intake_model_send)" || rc=$?
      if [ "$json_output" = "1" ]; then
        [ -n "$result" ] && printf '%s\n' "$result"
        return $rc
      fi
      [ "$rc" = "0" ] || return $rc
      printf '%s' "$result" | jq -r '"  batch \(.batches[] | "\(.batch_index): \(.status)（建议 \(.suggestions | length)，丢弃 \(.rejected | length)）")"'
      printf '%s' "$result" | jq -r '"  合计：成功 \(.summary.ok)，部分 \(.summary.partial)，失败 \(.summary.failed)，建议 \(.summary.suggestions)"'
      log_info "  结果已保存（每次尝试单独留存，重试不覆盖）: $(intake_ai_results_dir "$repo" "$request_id")"
      ;;

    show)
      local man
      if [ -n "$request_id" ]; then
        man="$(intake_ai_manifest_read "$repo" "$request_id")"
      else
        man='{"schema":"intake/v1","error":"request_required"}'
      fi
      if [ "$json_output" = "1" ]; then
        printf '%s\n' "$man"
      else
        printf '%s' "$man" | jq -r '.batches[]? | "  batch \(.index)/\(.total)：\(.status)（尝试 \(.attempts | length) 次）"'
      fi
      ;;
    *)
      cmd_intake help
      ;;
  esac
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
  # Parse global options
  while [ $# -gt 0 ]; do
    case "$1" in
      --debug)
        export AIWS_DEBUG=1
        shift
        ;;
      --help|-h)
        show_help
        exit 0
        ;;
      --version|-v)
        echo "aiws v${AIWS_VERSION}"
        exit 0
        ;;
      -*)
        if [ -z "${COMMAND:-}" ]; then
          log_error "Unknown option: $1"
          show_help
          exit 1
        fi
        break
        ;;
      *)
        COMMAND="$1"
        shift
        break
        ;;
    esac
  done
  
  # Dispatch command
  case "${COMMAND:-}" in
    setup)
      cmd_setup "$@"
      ;;
    sync)
      cmd_sync "$@"
      ;;
    validate)
      cmd_validate "$@"
      ;;
    mcp)
      cmd_mcp "$@"
      ;;
    skills)
      cmd_skills "$@"
      ;;
    rules)
      cmd_rules "$@"
      ;;
    memory)
      cmd_memory "$@"
      ;;
    secrets)
      cmd_secrets "$@"
      ;;
    import)
      cmd_import "$@"
      ;;
    intake)
      cmd_intake "$@"
      ;;
    hooks)
      cmd_hooks "$@"
      ;;
    ci)
      cmd_ci "$@"
      ;;
    help|"")
      show_help
      ;;
    *)
      log_error "Unknown command: $COMMAND"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
